# Care Companion weather provider.
# Keep "mock" for offline demonstrations. For QWeather, use the account-specific
# API Host shown in the QWeather console, not devapi.qweather.com.
WEATHER_PROVIDER=mock
QWEATHER_API_KEY=
QWEATHER_API_HOST=
# QWeather accepts a LocationID or longitude,latitude. Coordinates are sent
# with two decimal places according to the current Weather Now API contract.
QWEATHER_LOCATION=118.80,32.06
QWEATHER_TIMEOUT_SECONDS=3
